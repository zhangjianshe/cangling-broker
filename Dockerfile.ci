# syntax=docker/dockerfile:1
# CI image: copies a prebuilt binary compiled on the matching runner.
# Local builds should use Dockerfile instead.

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /data --create-home app \
    && mkdir -p /data/logs \
    && chown -R app:app /data

ARG TARGETARCH
COPY binaries/${TARGETARCH}/cangling-broker /usr/local/bin/cangling-broker

USER app
WORKDIR /data
ENV CL_BROKER_DATA=/data
EXPOSE 7500 7501 7883 8083
ENTRYPOINT ["cangling-broker"]
